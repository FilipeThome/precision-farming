# Local demo defaults. Copy to `.env` for Compose / bootRun.
# Demo secrets are allowed only with ALLOW_DEMO_SECRETS=true or Spring profile `local`.
# Staging/prod: set a real RS256 keypair / DB_PASSWORD and ALLOW_DEMO_SECRETS=false (or omit).
# Public key: copy JWT_PUBLIC_KEY from deploy/compose/demo.env.
# Auth-only private key and mint/membership secrets: deploy/compose/demo-auth.env (never share in demo.env).

ALLOW_DEMO_SECRETS=true
JWT_PUBLIC_KEY=
# OpenAPI/Swagger off by default; set true only for local demo.
SPRINGDOC_ENABLED=false
AUTH_RATE_LIMIT=20
DB_USER=precision
DB_PASSWORD=precision
DB_HOST=localhost
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=precision
RABBIT_PASSWORD=precision
REDIS_HOST=localhost
REDIS_PORT=6379
MINIO_ROOT_USER=precision
MINIO_ROOT_PASSWORD=precisionminio
ANDROID_GOOGLE_MAPS_API_KEY=
IOS_GOOGLE_MAPS_API_KEY=
GOOGLE_MAP_DEFAULT_TYPE=satellite
VITE_API_BASE_URL=http://localhost:8080
GATEWAY_PORT=8080
