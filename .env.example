# Local demo defaults. Copy to `.env` for Compose / bootRun.
# Demo secrets are allowed only with ALLOW_DEMO_SECRETS=true or Spring profile `local`.
# Staging/prod: set strong JWT_SECRET/DB_PASSWORD and ALLOW_DEMO_SECRETS=false (or omit).

ALLOW_DEMO_SECRETS=true
JWT_SECRET=precision-farming-demo-jwt-secret-key-32
DB_USER=precision
DB_PASSWORD=precision
DB_HOST=localhost
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=precision
RABBIT_PASSWORD=precision
REDIS_HOST=localhost
REDIS_PORT=6379
MINIO_ROOT_USER=precision
MINIO_ROOT_PASSWORD=precisionminio
WEB_GOOGLE_MAPS_API_KEY=
ANDROID_GOOGLE_MAPS_API_KEY=
IOS_GOOGLE_MAPS_API_KEY=
GOOGLE_MAP_DEFAULT_TYPE=satellite
VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_MAPS_API_KEY=
GATEWAY_PORT=8080
