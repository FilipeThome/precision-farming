# syntax=docker/dockerfile:1.7
# Gateway uses the same optimized JVM multi-stage pattern.
# Context: repository root.

ARG GRADLE_PROJECT=:backend:gateway
ARG MODULE_DIR=backend/gateway

FROM eclipse-temurin:21-jdk-alpine AS builder
ARG GRADLE_PROJECT
ARG MODULE_DIR
WORKDIR /src

RUN apk add --no-cache bash

COPY gradlew settings.gradle.kts ./
COPY gradle ./gradle
COPY backend ./backend

RUN chmod +x gradlew \
  && ./gradlew "${GRADLE_PROJECT}:bootJar" -x test --no-daemon \
  && mkdir -p /out \
  && JAR="$(ls ${MODULE_DIR}/build/libs/*.jar | grep -v -- '-plain' | head -n 1)" \
  && cp "$JAR" /out/app.jar

FROM eclipse-temurin:21-jre-alpine AS runtime
RUN apk add --no-cache curl \
  && addgroup -S app && adduser -S app -G app
WORKDIR /app

COPY --from=builder /out/app.jar /app/app.jar

ENV SERVER_PORT=8080 \
    JAVA_OPTS="-XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom"

USER app
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=5 \
  CMD curl -fsS "http://127.0.0.1:${SERVER_PORT}/actuator/health" || exit 1

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
