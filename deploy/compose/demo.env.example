APP_SEED=true
# OpenAPI/Swagger inside containers (not published on host; use bootRun for UI).
SPRINGDOC_ENABLED=false
AUTH_RATE_LIMIT=20
DB_USER=precision
DB_PASSWORD=precision
RABBIT_USER=precision
RABBIT_PASSWORD=precision
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672

# Docker DNS â€” each Spring service listens on 8080 inside the network.
