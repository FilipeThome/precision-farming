# Local demo defaults for app containers (NOT for production).
# Used by deploy/compose/*.yml together with root docker-compose.yml infra.

ALLOW_DEMO_SECRETS=true
JWT_SECRET=precision-farming-demo-jwt-secret-key-32
APP_SEED=true
# OpenAPI/Swagger inside containers (not published on host; use bootRun for UI).
SPRINGDOC_ENABLED=true
AUTH_RATE_LIMIT=20
DB_USER=precision
DB_PASSWORD=precision
RABBIT_USER=precision
RABBIT_PASSWORD=precision
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672

# Docker DNS — each Spring service listens on 8080 inside the network.
AUTH_URL=http://auth:8080
FARM_URL=http://farm:8080
ASSET_URL=http://asset:8080
TELEMETRY_URL=http://telemetry:8080
WEATHER_URL=http://weather:8080
OPERATION_URL=http://operation:8080
INVENTORY_URL=http://inventory:8080
ALERT_URL=http://alert:8080
AI_URL=http://ai:8080
NOTIFICATION_URL=http://notification:8080
FILE_URL=http://file:8080
REPORTING_URL=http://reporting:8080
SYNC_URL=http://sync:8080
INTEGRATION_URL=http://integration:8080
AGRONOMY_URL=http://agronomy:8080
IRRIGATION_URL=http://irrigation:8080
HARVEST_URL=http://harvest:8080
FINANCE_URL=http://finance:8080
COMPLIANCE_URL=http://compliance:8080
